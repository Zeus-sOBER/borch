# ── Clip Bot Environment Variables ────────────────────────────
# Copy these into your .env.local file

# Already in your app (Twitch app credentials)
TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_CLIENT_SECRET=your_twitch_app_client_secret

# Bot identity — can be your own Twitch account
TWITCH_BOT_USERNAME=your_twitch_username
# Get this OAuth token from https://twitchapps.com/tmi/
TWITCH_BOT_OAUTH=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your channel's numeric user ID — find it at https://www.streamweasels.com/tools/convert-twitch-username-to-user-id/
TWITCH_BROADCASTER_ID=123456789

# Channel to join (no #)
TWITCH_CHANNEL=yourchannelname

# Secret shared between bot and website — make this something random
CLIP_BOT_SECRET=pick-any-secret-string

# Shared secret for verifying EventSub webhook signatures (can be same as CLIP_BOT_SECRET)
TWITCH_EVENTSUB_SECRET=pick-any-secret-string

# Your deployed site URL (used for OAuth redirect + EventSub webhook URL)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app
DYNASTY_API_URL=https://your-site.vercel.app

# ── Game Context (update before each session) ──────────────────
# Update these each time you stream a new game
CLIP_CURRENT_SEASON=1
CLIP_CURRENT_WEEK=3
CLIP_HOME_TEAM=Alabama
CLIP_AWAY_TEAM=Georgia
