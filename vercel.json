{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/decay-old-events",
      "schedule": "0 6 * * *"
    }
  ],
  "env": {
    "ANTHROPIC_API_KEY": { "required": true, "description": "Claude AI API key from console.anthropic.com" },
    "NEXT_PUBLIC_SUPABASE_URL": { "required": true, "description": "Supabase project URL" },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": { "required": true, "description": "Supabase anon/public key" },
    "SUPABASE_SERVICE_ROLE_KEY": { "required": true, "description": "Supabase service role key (server-side only)" },
    "COMMISSIONER_PIN": { "required": true, "description": "PIN code for commissioner access (you choose this)" }
  }
}
